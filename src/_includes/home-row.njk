{%- set es = (lang == "es") -%}
{%- set p = e.project -%}
{%- if e.feature %}
        <a class="v4-row v4-r" href="{{ '/es' if es }}/work/{{ p.slug }}/" data-project="{{ p.dataProject }}">
          <div class="v4-row-main">
            <div class="v4-row-thumbs" aria-hidden="true">
              <div class="v4-frame"><img src="/assets/images/work/{{ p.slug }}/{{ p.images[0] }}" alt="" width="{{ e.sizes[0][0] }}" height="{{ e.sizes[0][1] }}" loading="lazy" decoding="async"></div>
              <div class="v4-frame"><img src="/assets/images/work/{{ p.slug }}/{{ p.images[1] }}" alt="" width="{{ e.sizes[1][0] }}" height="{{ e.sizes[1][1] }}" loading="lazy" decoding="async"></div>
            </div>
            <span class="v4-row-client">{{ p.client }}</span>
            <h3 class="v4-row-title">{{ p.es if es else p.en }}</h3>
            <p class="v4-row-desc">{{ e.desc[lang] }}</p>
          </div>
          <span class="v4-row-tags">{% if p.current %}<span class="v4-tag-current">{{ 'Actual' if es else 'Current' }}</span> · {% endif %}{{ e.tags[lang] }}</span>
          <span class="arrow">→</span>
        </a>
{%- else %}
        <a class="v4-row v4-row--compact v4-r" href="{{ '/es' if es }}/work/{{ p.slug }}/">
          <div class="v4-row-main">
            <h3 class="v4-row-title">{{ p.es if es else p.en }}</h3>
          </div>
          <span class="v4-row-tags">{% if p.current %}<span class="v4-tag-current">{{ 'Actual' if es else 'Current' }}</span> · {% endif %}{{ e.tags[lang] }}</span>
          <span class="arrow">→</span>
        </a>
{%- endif %}
