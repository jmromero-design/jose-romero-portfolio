<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 432" role="img" aria-hidden="true">
  <defs><style>
    .e3sl { font-family: var(--font-body); font-size: 7.5px; font-weight: 700; letter-spacing: 1.5px; text-anchor: middle; }
    .e3h  { font-family: var(--font-body); font-size: 9.5px; font-weight: 600; fill: var(--text-secondary); text-anchor: middle; }
    .e3s  { font-family: var(--font-body); font-size: 8px; font-weight: 300; fill: var(--text-tertiary); text-anchor: middle; }
    .e3t  { font-family: var(--font-display); font-size: 12px; font-weight: 400; fill: var(--text-primary); text-anchor: middle; }
  </style></defs>
  <text class="e3sl" x="180" y="16" fill="#5C5955">FRAGILE: PERSON-DEPENDENT</text>
  <rect x="8" y="24" width="164" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e3h" x="90" y="40">Memory Dependent</text>
  <text class="e3s" x="90" y="55">Process lives only in people's heads</text>
  <rect x="180" y="24" width="172" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e3h" x="266" y="40">Informal Transmit</text>
  <text class="e3s" x="266" y="55">Passed verbally, undocumented</text>
  <rect x="8" y="76" width="164" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e3h" x="90" y="92">Person Unavailable</text>
  <text class="e3s" x="90" y="107">Process holder shifts or leaves</text>
  <rect x="180" y="76" width="172" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e3h" x="266" y="92">Operational Collapse</text>
  <text class="e3s" x="266" y="107">Workflow degrades or vanishes</text>
  <line x1="180" y1="124" x2="180" y2="140" stroke="var(--gold)" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
  <polygon points="180,142 176,136 184,136" fill="var(--gold)" opacity="0.6"/>
  <rect x="8" y="150" width="344" height="76" rx="6" fill="var(--gold)" fill-opacity="0.06" stroke="var(--gold)" stroke-width="1.5"/>
  <text class="e3sl" x="180" y="168" fill="var(--gold)">CONSOLIDATION CORE</text>
  <text class="e3h" x="180" y="187" style="fill:var(--gold);">Map task types. Derive rules.</text>
  <text class="e3s" x="180" y="203">Embed structure in tools. Document for imperfect adoption.</text>
  <text class="e3s" x="180" y="216">Design so the process survives without you.</text>
  <line x1="180" y1="230" x2="180" y2="246" stroke="var(--teal)" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
  <polygon points="180,248 176,242 184,242" fill="var(--teal)" opacity="0.6"/>
  <text class="e3sl" x="180" y="260" fill="var(--teal-text)">RESILIENT: PRINCIPLE-FIRST</text>
  <rect x="8" y="268" width="164" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--teal)" stroke-opacity="0.4" stroke-width="1"/>
  <text class="e3h" x="90" y="284" style="fill:var(--teal-text);">Survives Personnel</text>
  <text class="e3s" x="90" y="299">New members onboard without a guide</text>
  <rect x="180" y="268" width="172" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--teal)" stroke-opacity="0.4" stroke-width="1"/>
  <text class="e3h" x="266" y="284" style="fill:var(--teal-text);">Teachable</text>
  <text class="e3s" x="266" y="299">Documented, not person-dependent</text>
  <rect x="8" y="320" width="164" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--teal)" stroke-opacity="0.4" stroke-width="1"/>
  <text class="e3h" x="90" y="336" style="fill:var(--teal-text);">Low Maintenance</text>
  <text class="e3s" x="90" y="351">Holds even when no one tends it</text>
  <rect x="180" y="320" width="172" height="44" rx="5" fill="var(--bg-surface-2)" stroke="var(--teal)" stroke-opacity="0.4" stroke-width="1"/>
  <text class="e3h" x="266" y="336" style="fill:var(--teal-text);">Structural Bones</text>
  <text class="e3s" x="266" y="351">Fails visibly, not silently</text>
  <rect x="8" y="374" width="344" height="50" rx="6" fill="var(--teal)" fill-opacity="0.05" stroke="var(--teal)" stroke-width="1.5"/>
  <text class="e3t" x="180" y="394">Imperfect adoption of a well-structured</text>
  <text class="e3t" x="180" y="414">system is the success condition.</text>
</svg>
