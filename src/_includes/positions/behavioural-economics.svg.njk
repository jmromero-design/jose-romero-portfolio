<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 502" role="img" aria-hidden="true">
  <defs><style>
    .e2sl { font-family: var(--font-body); font-size: 7.5px; font-weight: 700; letter-spacing: 1.5px; text-anchor: middle; }
    .e2t  { font-family: var(--font-display); font-size: 12px; font-weight: 400; fill: var(--text-primary); text-anchor: middle; }
    .e2h  { font-family: var(--font-body); font-size: 9.5px; font-weight: 600; fill: var(--text-secondary); text-anchor: middle; }
    .e2s  { font-family: var(--font-body); font-size: 8px; font-weight: 300; fill: var(--text-tertiary); text-anchor: middle; }
  </style></defs>
  <text class="e2sl" x="180" y="16" fill="var(--text-tertiary)">01 / INQUIRY</text>
  <rect x="8" y="24" width="164" height="108" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e2sl" x="90" y="42" fill="var(--text-tertiary)">STANDARD</text>
  <text class="e2t" x="90" y="62">Stated</text>
  <text class="e2t" x="90" y="78">Preferences</text>
  <text class="e2s" x="90" y="96" style="fill:var(--gold);font-weight:500;">"What do users need?"</text>
  <text class="e2s" x="90" y="111">Intent–action gap applies</text>
  <text class="e2s" x="90" y="124" style="fill:var(--gold);">↓ Less predictive</text>
  <rect x="180" y="24" width="172" height="108" rx="5" fill="var(--bg-surface-2)" stroke="var(--teal)" stroke-opacity="0.5" stroke-width="1"/>
  <rect x="180" y="24" width="3" height="108" rx="1.5" fill="var(--teal)" opacity="0.6"/>
  <text class="e2sl" x="267" y="42" fill="var(--teal-text)">BEHAVIORAL</text>
  <text class="e2t" x="267" y="62">Revealed</text>
  <text class="e2t" x="267" y="78">Preferences</text>
  <text class="e2s" x="267" y="96" style="fill:var(--teal-text);font-weight:500;">"What will users do?"</text>
  <text class="e2s" x="267" y="111">Observed choices &amp; A/B data</text>
  <text class="e2s" x="267" y="124" style="fill:var(--teal-text);">↓ More predictive</text>
  <text class="e2sl" x="180" y="148" fill="var(--text-tertiary)">02 / PSYCHOLOGICAL LEVERS</text>
  <rect x="8" y="158" width="164" height="76" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e2h" x="90" y="176">01 / Framing</text>
  <text class="e2s" x="90" y="192">Structures choices to highlight</text>
  <text class="e2s" x="90" y="206">salience. Guides decisions</text>
  <text class="e2s" x="90" y="220">without restricting them.</text>
  <rect x="180" y="158" width="172" height="76" rx="5" fill="var(--bg-surface-2)" stroke="var(--teal)" stroke-opacity="0.5" stroke-width="1"/>
  <text class="e2h" x="267" y="176" style="fill:var(--teal-text);">02 / Defaults</text>
  <text class="e2s" x="267" y="192">Pre-selected paths of least</text>
  <text class="e2s" x="267" y="206">resistance. Highest conversion</text>
  <text class="e2s" x="267" y="220">leverage of the four.</text>
  <rect x="8" y="242" width="164" height="76" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e2h" x="90" y="260">03 / Effort</text>
  <text class="e2s" x="90" y="276">Minimise friction for desired</text>
  <text class="e2s" x="90" y="290">actions. Add friction to slow</text>
  <text class="e2s" x="90" y="304">errors and exits.</text>
  <rect x="180" y="242" width="172" height="76" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e2h" x="267" y="260">04 / Context</text>
  <text class="e2s" x="267" y="276">Environmental prompts timed</text>
  <text class="e2s" x="267" y="290">to peak motivation states</text>
  <text class="e2s" x="267" y="304">and user readiness.</text>
  <text class="e2sl" x="180" y="330" fill="var(--text-tertiary)">03 / OUTCOMES</text>
  <rect x="8" y="340" width="344" height="52" rx="5" fill="var(--bg-surface-2)" stroke="var(--border-default)" stroke-width="1"/>
  <text class="e2sl" x="180" y="358" fill="var(--text-tertiary)">UNOPTIMIZED</text>
  <text class="e2t" x="180" y="376">Stated Intent Interface</text>
  <text class="e2s" x="180" y="390">High friction · Low conversion · Assumes rational actors</text>
  <rect x="8" y="400" width="344" height="94" rx="5" fill="var(--teal)" fill-opacity="0.05" stroke="var(--teal)" stroke-width="1.5"/>
  <text class="e2sl" x="180" y="418" fill="var(--teal-text)">OPTIMIZED</text>
  <text class="e2t" x="180" y="438">Action-Aligned Design</text>
  <text class="e2s" x="180" y="456">Choice architecture tailored to cognitive heuristics</text>
  <text class="e2s" x="180" y="470" style="fill:var(--teal-text);">· Minimal cognitive friction · High default compliance</text>
  <text class="e2s" x="180" y="484" style="fill:var(--teal-text);">· Symmetrical choice loops</text>
</svg>
