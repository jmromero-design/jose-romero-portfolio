<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 420" role="img" aria-hidden="true">
  <defs><style>
    .e1l { font-family: var(--font-body); font-size: 7.5px; font-weight: 700; letter-spacing: 1.2px; text-anchor: middle; }
    .e1t { font-family: var(--font-display); font-size: 13px; font-weight: 400; fill: var(--text-primary); text-anchor: middle; }
    .e1s { font-family: var(--font-body); font-size: 8.5px; font-weight: 300; fill: var(--text-tertiary); text-anchor: start; }
    .e1c { font-family: var(--font-body); font-size: 8px; font-weight: 300; fill: var(--text-tertiary); text-anchor: middle; }
  </style></defs>
  <rect x="8" y="8" width="344" height="174" rx="6" fill="var(--bg-surface-2)" stroke="#E28B72" stroke-opacity="0.3" stroke-width="1"/>
  <text class="e1l" x="180" y="28" fill="#E28B72">EMOTIONAL · COMPASSION-LED</text>
  <text class="e1t" x="180" y="50">Emotional Empathy</text>
  <ellipse cx="62" cy="118" rx="46" ry="36" fill="none" stroke="#E28B72" stroke-width="0.8" opacity="0.10"/>
  <ellipse cx="62" cy="118" rx="32" ry="25" fill="none" stroke="#E28B72" stroke-width="0.8" opacity="0.20"/>
  <ellipse cx="62" cy="118" rx="18" ry="14" fill="none" stroke="#E28B72" stroke-width="1" opacity="0.35"/>
  <circle cx="62" cy="118" r="7" fill="#E28B72" opacity="0.50"/>
  <text style="font-family:var(--font-body);font-size:6.5px;font-weight:600;fill:#E28B72;text-anchor:middle;" x="62" y="160">SHARED FEELING</text>
  <text class="e1s" x="118" y="68">Feeling what others feel.</text>
  <text class="e1s" x="118" y="83">The foundation of personal connection</text>
  <text class="e1s" x="118" y="97">and deep user trust.</text>
  <line x1="118" y1="108" x2="340" y2="108" stroke="var(--border-default)" stroke-width="0.5" opacity="0.4"/>
  <text class="e1s" x="118" y="122">Harder to sustain across large teams</text>
  <text class="e1s" x="118" y="136">where incentives conflict and</text>
  <text class="e1s" x="118" y="150">mental models diverge.</text>
  <text class="e1s" x="118" y="167" style="fill:#E28B72;font-weight:600;">Personal context · Deep relationships</text>
  <text class="e1c" x="180" y="199">↓  not a replacement, a complement  ↓</text>
  <rect x="8" y="210" width="344" height="192" rx="6" fill="var(--bg-surface-2)" stroke="var(--teal)" stroke-opacity="0.4" stroke-width="1"/>
  <rect x="8" y="210" width="3" height="192" rx="1.5" fill="var(--teal)" opacity="0.6"/>
  <text class="e1l" x="180" y="232" fill="var(--teal-text)">POSITIONAL · ACCURACY-LED</text>
  <text class="e1t" x="180" y="254">Positional Empathy</text>
  <line x1="30" y1="338" x2="96" y2="338" stroke="var(--border-strong)" stroke-width="0.8" opacity="0.5"/>
  <line x1="30" y1="338" x2="30" y2="276" stroke="var(--border-strong)" stroke-width="0.8" opacity="0.5"/>
  <circle cx="44" cy="328" r="3.5" fill="var(--teal)" opacity="0.65"/>
  <line x1="44" y1="328" x2="60" y2="310" stroke="var(--teal)" stroke-width="0.7" stroke-dasharray="2 2" opacity="0.5"/>
  <circle cx="60" cy="310" r="3.5" fill="var(--teal)" opacity="0.65"/>
  <line x1="60" y1="310" x2="78" y2="291" stroke="var(--teal)" stroke-width="0.7" stroke-dasharray="2 2" opacity="0.5"/>
  <circle cx="78" cy="291" r="3.5" fill="var(--teal)" opacity="0.65"/>
  <circle cx="78" cy="291" r="9" fill="none" stroke="var(--teal)" stroke-width="1" opacity="0.35"/>
  <text style="font-family:var(--font-body);font-size:6.5px;font-weight:600;fill:var(--teal-text);text-anchor:middle;" x="60" y="354">ALIGNMENT PATH</text>
  <text class="e1s" x="118" y="274">Mapping what others see,</text>
  <text class="e1s" x="118" y="289">optimise for, and fear.</text>
  <line x1="118" y1="300" x2="340" y2="300" stroke="var(--border-default)" stroke-width="0.5" opacity="0.4"/>
  <text class="e1s" x="118" y="314">Designed for professional complexity,</text>
  <text class="e1s" x="118" y="328">navigating environments where</text>
  <text class="e1s" x="118" y="342">incentives diverge and alignment</text>
  <text class="e1s" x="118" y="356">requires navigation, not feeling.</text>
  <text class="e1s" x="118" y="376" style="fill:var(--teal-text);font-weight:600;">Professional context · Org navigation</text>
  <text class="e1c" x="180" y="413">Both modes matter. Context determines which one leads.</text>
</svg>
