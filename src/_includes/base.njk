<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | safe }}</title>
  <meta name="description" content="{{ description | safe }}">
  <link rel="canonical" href="{{ site.url }}{{ cleanUrl }}">
{%- if cleanUrl != "/" and cleanUrl != "/es/" %}
  <link rel="alternate" type="text/markdown" href="/md{{ cleanUrl }}index.md">
{%- endif %}
{%- if robots %}
  <meta name="robots" content="{{ robots }}">
{%- endif %}

  <!-- Open Graph -->
  <meta property="og:title" content="{{ (ogTitle or title) | safe }}">
  <meta property="og:description" content="{{ (ogDescription or description) | safe }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:url" content="{{ site.url }}{{ cleanUrl }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="Jose Romero">
  <meta property="og:locale" content="{{ 'es_ES' if lang == 'es' else 'en_US' }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ (twitterTitle or ogTitle or title) | safe }}">
  <meta name="twitter:description" content="{{ (twitterDescription or ogDescription or description) | safe }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
  <link rel="alternate" hreflang="es" href="{{ site.url }}{{ esUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ enUrl }}">
{%- block head %}{% endblock %}
  <link rel="stylesheet" href="/assets/css/main.css?v={{ site.cssVersion }}">
  <!-- Headings render in Bitter (regular and the italic accent): fetch both with the CSS, not after it -->
  <link rel="preload" href="/assets/fonts/bitter-latin-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/bitter-latin-italic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">

  <!-- Language detection: must run before page renders -->
  <script src="/assets/js/lang-detect.js?v={{ site.langJsVersion }}"></script>
{%- block styles %}{% endblock %}
  <script defer src="/_vercel/insights/script.js"></script>
  <script defer src="/_vercel/speed-insights/script.js"></script>
</head>

{% block body %}{% endblock %}
