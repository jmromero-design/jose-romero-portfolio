{%- set es = (lang == "es") -%}
"itemListElement": [
{%- for p in projects %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "url": "{{ site.url }}{{ '/es' if es }}/work/{{ p.slug }}/",
          "name": {{ (p.es if es else p.en) | dump | safe }}
        }{{ "," if not loop.last }}
{%- endfor %}
      ]
