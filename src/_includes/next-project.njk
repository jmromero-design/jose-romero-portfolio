{%- set es = (lang == "es") -%}
{%- set idx = 0 -%}
{%- for p in projects -%}{%- if p.slug == page.fileSlug -%}{%- set idx = loop.index0 -%}{%- endif -%}{%- endfor -%}
{%- set next = projects[(idx + 1) % projects.length] -%}
<a href="{{ '/es' if es }}/work/{{ next.slug }}/" class="next-project reveal">
          <div>
            <div class="next-project-label">{% if idx == projects.length - 1 %}{{ 'Volver al primer proyecto' if es else 'Back to first project' }}{% else %}{{ 'Siguiente proyecto' if es else 'Next project' }}{% endif %}</div>
            <div class="next-project-title">{{ next.es if es else next.en }} →</div>
          </div>
          <span style="color: var(--gold); font-size: var(--text-3xl); font-family: var(--font-display);">→</span>
        </a>
